# 服务端口
PORT=5000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=used_car_platform

# JWT 密钥（生产环境务必更换为随机字符串）
JWT_SECRET=your_jwt_secret_here_change_in_production

# CORS 允许的来源（生产环境设置为实际域名，如 https://example.com）
CORS_ORIGIN=*

# 管理员默认密码（首次启动时创建管理员账号）
ADMIN_PASSWORD=admin123

# 上传文件目录
UPLOAD_DIR=uploads
